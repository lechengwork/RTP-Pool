-- 將 __KAFKA_*__ placeholders 填妥並經 DBA 審閱後，改名為 .sql 才可執行。
-- 此表保存可去重、可重播的原始事件；不等同 telemetry。
-- Producer 必須以 AGT_Agent1 × GM_GameCode × GameServer_Version 作為 Kafka message key，
-- 保證同一水池的事件固定進入同一 partition，聚合服務才能按 offset 有序重播。

CREATE TABLE IF NOT EXISTS icrown.rtp_basic_pool_raw_event_local
ON CLUSTER sg_cluster
(
    AGT_Agent1 String COMMENT '總代 ID',
    GM_GameCode LowCardinality(String) COMMENT '老虎機 ID',
    GameServer_Version LowCardinality(String) COMMENT 'RTP 版本 ID；保留前導零，例如 0970',
    event_at DateTime64(6, 'Etc/GMT+4') COMMENT 'spin 結算時間',
    bet Float64 COMMENT '當轉總下注',
    win Float64 COMMENT '當轉總派彩',
    r Float64 COMMENT '當轉目標 RTP',
    is_buy_type UInt8 COMMENT '1＝購買類型；只記帳、不 steer',
    kafka_topic LowCardinality(String) COMMENT 'Kafka topic',
    kafka_partition UInt64 COMMENT 'Kafka partition',
    kafka_offset UInt64 COMMENT 'Kafka offset；管線去重鍵的一部分',
    ingested_at DateTime64(6, 'Etc/GMT+4') COMMENT 'ClickHouse 落地時間'
)
ENGINE = ReplicatedReplacingMergeTree(
    '/clickhouse/tables/{shard}/icrown/rtp_basic_pool_raw_event_local',
    '{replica}',
    ingested_at
)
PARTITION BY toYYYYMM(event_at)
ORDER BY (kafka_topic, kafka_partition, kafka_offset);

CREATE TABLE IF NOT EXISTS icrown.rtp_basic_pool_raw_event
ON CLUSTER sg_cluster
AS icrown.rtp_basic_pool_raw_event_local
ENGINE = Distributed(
    'sg_cluster',
    'icrown',
    'rtp_basic_pool_raw_event_local',
    cityHash64(kafka_topic, kafka_partition)
);

CREATE TABLE IF NOT EXISTS icrown.rtp_basic_pool_kafka_source
ON CLUSTER sg_cluster
(
    AGT_Agent1 String,
    GM_GameCode String,
    GameServer_Version String,
    event_at DateTime64(6, 'Etc/GMT+4'),
    bet Float64,
    win Float64,
    r Float64,
    is_buy_type UInt8
)
ENGINE = Kafka
SETTINGS
    kafka_broker_list = '__KAFKA_BROKERS__',
    kafka_topic_list = '__RTP_BASIC_POOL_TOPIC__',
    kafka_group_name = '__RTP_BASIC_POOL_CONSUMER_GROUP__',
    kafka_format = 'JSONEachRow',
    kafka_num_consumers = __KAFKA_NUM_CONSUMERS__;

CREATE MATERIALIZED VIEW IF NOT EXISTS icrown.rtp_basic_pool_kafka_to_raw_event
ON CLUSTER sg_cluster
TO icrown.rtp_basic_pool_raw_event
AS
SELECT
    AGT_Agent1,
    GM_GameCode,
    GameServer_Version,
    event_at,
    bet,
    win,
    r,
    is_buy_type,
    _topic AS kafka_topic,
    _partition AS kafka_partition,
    _offset AS kafka_offset,
    now64(6) AS ingested_at
FROM icrown.rtp_basic_pool_kafka_source;
